# Copia este archivo como .env.local (desarrollo) o define las variables en Vercel.
# Ningún valor de este archivo es real: complétalos con los datos de MPST.

# Dominio definitivo (canonical, sitemap, Open Graph). En Vercel, si se omite,
# se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=

# ── Envío del formulario de cotización (elige UNA opción) ──
# A) Webhook: Make, Zapier, n8n, Google Apps Script, Formspree, un CRM…
COTIZACION_WEBHOOK_URL=
COTIZACION_WEBHOOK_TOKEN=

# B) Correo con Resend (https://resend.com), con el dominio remitente verificado
RESEND_API_KEY=
COTIZACION_CORREO_DESTINO=
COTIZACION_CORREO_REMITENTE=
